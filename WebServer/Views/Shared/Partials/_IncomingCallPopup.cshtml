@using WebServer.ViewModels.WebServer.ViewModels
@model IncomingCallVm

@{
    var isAudio = string.Equals(Model.CallType, "audio", StringComparison.OrdinalIgnoreCase);
    var callTypeText = isAudio ? "cuộc gọi thoại" : "cuộc gọi video";
    var callerName = string.IsNullOrWhiteSpace(Model.FromUserName) ? "Người dùng" : Model.FromUserName;
    var callerPhoto = string.IsNullOrWhiteSpace(Model.FromUserPhoto)
        ? Url.Content("~/assets/images/avatar-default.png")
        : Model.FromUserPhoto;
    var defaultAvatar = Url.Content("~/assets/images/avatar-default.png");
}

<div class="vdcall_consumer_call-modal-backdrop"
     data-vdcall-popup="1"
     data-conversation-id="@Model.ConversationId"
     data-call-type="@Model.CallType"
     data-me-id="@Model.ToUserId"
     data-me-name="@Model.ToUserName"
     data-me-photo="@Model.ToUserPhoto"
     data-peer-id="@Model.FromUserId"
     data-peer-name="@callerName"
     data-peer-photo="@callerPhoto">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <div class="vdcall_consumer_call-card" role="dialog" aria-modal="true" aria-label="Cuộc gọi đến">
        <button class="vdcall_consumer_close-btn" type="button" title="Từ chối" aria-label="Từ chối">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="vdcall_consumer_pulse" aria-hidden="true"></div>

        <div class="vdcall_consumer_avatar">
            <img src="@callerPhoto" alt="@callerName" onerror="this.onerror=null;this.src='@defaultAvatar';" />
        </div>

        <div class="vdcall_consumer_incoming-label">Đang có @callTypeText đến</div>
        <div class="vdcall_consumer_caller-name">@callerName</div>

        <div class="vdcall_consumer_encrypted">
            <i class="fa-solid fa-lock"></i>
            Kết nối riêng tư qua WebRTC
        </div>

        <div class="vdcall_consumer_actions">
            <button class="vdcall_consumer_action-btn"
                    type="button"
                    title="Từ chối"
                    aria-label="Từ chối"
                    data-action="decline">
                <span class="vdcall_consumer_action-circle vdcall_consumer_decline">
                    <i class="fa-solid fa-phone-slash"></i>
                </span>
                <span class="vdcall_consumer_action-label">Từ chối</span>
            </button>

            <button class="vdcall_consumer_action-btn"
                    type="button"
                    title="Nhận cuộc gọi"
                    aria-label="Nhận cuộc gọi"
                    data-action="accept">
                <span class="vdcall_consumer_action-circle vdcall_consumer_accept">
                    <i class="fa-solid @(isAudio ? "fa-phone" : "fa-video")"></i>
                </span>
                <span class="vdcall_consumer_action-label">Nhận</span>
            </button>
        </div>
    </div>
</div>
