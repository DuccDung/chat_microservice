@using WebServer.ViewModels.WebServer.ViewModels
@model CallPopupVm

@{
    var isAudio = string.Equals(Model.CallType, "audio", StringComparison.OrdinalIgnoreCase);
    var callTypeText = isAudio ? "Cuộc gọi thoại" : "Cuộc gọi video";
    var peerName = string.IsNullOrWhiteSpace(Model.PeerName) ? "Người dùng" : Model.PeerName;
    var peerPhoto = string.IsNullOrWhiteSpace(Model.PeerPhoto)
        ? Url.Content("~/assets/images/avatar-default.png")
        : Model.PeerPhoto;
    var defaultAvatar = Url.Content("~/assets/images/avatar-default.png");
}

<div class="call_pr_modal @(isAudio ? "call_pr_modal--audio" : "call_pr_modal--video")"
     data-call-popup="1"
     data-call-state="calling"
     data-conversation-id="@Model.ConversationId"
     data-call-type="@Model.CallType"
     data-me-id="@Model.MeId"
     data-me-name="@Model.MeName"
     data-me-photo="@Model.MePhoto"
     data-peer-id="@Model.PeerId"
     data-peer-name="@peerName"
     data-peer-photo="@peerPhoto">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <video class="call_pr_remote-video" id="remoteVideo" autoplay playsinline></video>
    <div class="call_pr_remote-fallback" aria-hidden="true"></div>

    <header class="call_pr_topbar">
        <div class="call_pr_peer">
            <div class="call_pr_peer-avatar">
                <img src="@peerPhoto" alt="@peerName" onerror="this.onerror=null;this.src='@defaultAvatar';" />
            </div>
            <div class="call_pr_peer-meta">
                <strong>@peerName</strong>
                <span data-call-status>@callTypeText - Đang gọi...</span>
            </div>
        </div>
    </header>

    <section class="call_pr_stage" aria-live="polite">
        <div class="call_pr_center-card">
            <div class="call_pr_avatar">
                <img src="@peerPhoto" alt="@peerName" onerror="this.onerror=null;this.src='@defaultAvatar';" />
            </div>
            <div class="call_pr_name">@peerName</div>
            <div class="call_pr_status" data-call-status>Đang gọi...</div>
            <div class="call_pr_signal" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </section>

    <aside class="call_pr_local-wrap" aria-label="Camera của bạn">
        <video class="call_pr_local-video" id="localVideo" autoplay muted playsinline></video>
        <div class="call_pr_local-empty">
            <i class="fa-solid fa-video-slash"></i>
            <span>Camera đang tắt</span>
        </div>
        <div class="call_pr_local-label">Bạn</div>
    </aside>

    <div class="call_pr_controls" role="toolbar" aria-label="Điều khiển cuộc gọi">
        <button class="call_pr_btn"
                type="button"
                data-action="toggle-camera"
                data-on="@(isAudio ? "0" : "1")"
                title="Bật/Tắt camera"
                aria-label="Bật/Tắt camera"
                @(isAudio ? "disabled" : "")>
            <i class="fa-solid @(isAudio ? "fa-video-slash" : "fa-video")"></i>
            <span>Camera</span>
        </button>

        <button class="call_pr_btn"
                type="button"
                data-action="toggle-mic"
                data-on="1"
                title="Tắt/Bật mic"
                aria-label="Tắt/Bật mic">
            <i class="fa-solid fa-microphone"></i>
            <span>Mic</span>
        </button>

        <button class="call_pr_btn call_pr_end"
                type="button"
                data-action="end"
                title="Kết thúc"
                aria-label="Kết thúc">
            <i class="fa-solid fa-phone-slash"></i>
            <span>Kết thúc</span>
        </button>
    </div>
</div>
